<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.scijava</groupId>
        <artifactId>pom-scijava</artifactId>
        <version>31.1.0</version>
        <relativePath/>
    </parent>

    <groupId>vesselreconstruction</groupId>
    <artifactId>vessel-reconstruction-ellipse</artifactId>
    <version>0.1.0-SNAPSHOT</version>

    <name>Vessel Reconstruction - Robust Ellipse Prototype</name>

    <description>
        Independent Fiji/ImageJ prototype for robust ellipse-based vessel
        lumen reconstruction.
    </description>

    <url>https://example.invalid/vessel-reconstruction-ellipse</url>

    <inceptionYear>2026</inceptionYear>

    <organization>
        <name>Independent Research Project</name>
        <url>https://example.invalid/</url>
    </organization>

    <licenses>
        <license>
            <name>CC0</name>
            <url>https://creativecommons.org/publicdomain/zero/1.0/</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Thomas Huber</name>
            <roles>
                <role>founder</role>
                <role>lead</role>
                <role>developer</role>
                <role>maintainer</role>
            </roles>
        </developer>
    </developers>

    <contributors>
        <contributor>
            <name>None</name>
        </contributor>
    </contributors>

    <mailingLists>
        <mailingList>
            <name>Image.sc Forum</name>
            <archive>https://forum.image.sc/tag/imagej</archive>
        </mailingList>
    </mailingLists>

    <scm>
        <connection>
            scm:git:https://example.invalid/vessel-reconstruction-ellipse.git
        </connection>
        <developerConnection>
            scm:git:https://example.invalid/vessel-reconstruction-ellipse.git
        </developerConnection>
        <tag>HEAD</tag>
        <url>https://example.invalid/vessel-reconstruction-ellipse</url>
    </scm>

    <issueManagement>
        <system>None</system>
        <url>https://example.invalid/vessel-reconstruction-ellipse/issues</url>
    </issueManagement>

    <ciManagement>
        <system>None</system>
    </ciManagement>

    <properties>
        <!--
            Fiji currently runs Java 8. Compiling with release 8 produces
            class-file version 52.0, which is compatible with that runtime.
        -->
        <maven.compiler.release>8</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <package-name>vesselreconstruction.ellipse</package-name>

        <main-class>
            vesselreconstruction.ellipse.EllipseReconstructionPlugin
        </main-class>

        <license.licenseName>cc0</license.licenseName>
        <license.copyrightOwners>Thomas Huber</license.copyrightOwners>

        <junit.jupiter.version>5.10.2</junit.jupiter.version>
        <maven.surefire.version>3.2.5</maven.surefire.version>

        <project.build.outputTimestamp>2026-08-11T00:00:00Z</project.build.outputTimestamp>
    </properties>

    <dependencies>
        <dependency>
            <groupId>net.imagej</groupId>
            <artifactId>ij</artifactId>
        </dependency>

        <dependency>
            <groupId>sc.fiji</groupId>
            <artifactId>Trainable_Segmentation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!--
      SciJava artifacts such as Trainable_Segmentation are published to
      maven.scijava.org, not Maven Central. The version remains managed by
      the pom-scijava parent (currently 3.2.35).
    -->
    <repositories>
        <repository>
            <id>scijava.public</id>
            <url>https://maven.scijava.org/content/groups/public</url>
        </repository>
    </repositories>

    <build>
        <finalName>VesselReconstructionEllipse-0.1.0-SNAPSHOT</finalName>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Implementation-Date>${project.build.outputTimestamp}</Implementation-Date>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven.surefire.version}</version>
                <configuration>
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
